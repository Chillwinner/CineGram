# CineVec 本体服务配置
CINEVEC_BASE_URL=http://127.0.0.1:8008
CINEVEC_API_TOKEN=

# 插件 FastAPI 服务配置
PLUGIN_HOST=127.0.0.1
PLUGIN_PORT=8018
PLUGIN_DATA_DIR=data

# Telegram MTProto 用户账号配置（历史回溯 / 实时群组同步 / 定时可用性巡检 / 大视频下载）
TG_API_ID=
TG_API_HASH=
TG_SESSION_NAME=tg_user_session

# Telegram Bot 配置（可选：留空则仅运行 MTProto 同步与 FastAPI 管理接口）
TG_BOT_TOKEN=
# 逗号分隔的允许使用 Bot 的 Telegram user_id；留空则拒绝所有外部用户（安全默认）
TG_ALLOWED_USER_IDS=

# 背压与传输控制
DISK_MIN_FREE_GB=10.0
MAX_PREPROCESS_INFLIGHT=2
MAX_FILE_SIZE_MB=4096
UPLOAD_BATCH_SIZE=10
MEDIA_GROUP_DEBOUNCE_SECONDS=1.5
UPLOAD_TIMEOUT_SECONDS=600.0

# 定时存活巡检（群改私密 / 被踢出 / 单条消息被删）
DEFAULT_CHECK_INTERVAL_HOURS=6.0
# 持续失效多少天后自动调用 CineVec exclude 清理向量；0 表示仅标 source_invalid 不自动清理
AUTO_EXCLUDE_AFTER_DAYS=0
